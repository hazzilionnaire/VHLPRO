# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the site is reachable. Used to build the magic-link redirect.
# On Vercel you can leave this unset — the production domain is detected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Defaults to America/Toronto.
NEXT_PUBLIC_LEAGUE_TIME_ZONE=America/Toronto
